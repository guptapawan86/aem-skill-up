{
  "filters": [
    {
      "id": "richtext",
      "rte": {
        "toolbar": {
          "format": ["bold", "italic", "underline", "strike"],
          "alignment": ["left", "center", "right", "justify"],
          "direction": ["rtl", "ltr"],
          "indentation": ["indent", "outdent"],
          "blocks": ["paragraph", "h1", "h2", "h3", "h4"],
          "list": ["bullet_list", "ordered_list"],
          "insert": ["link", "unlink", "image", "table", "special_characters"],
          "sr_script": ["superscript", "subscript"],
          "editor": ["removeformat", "paste_text"],
          "sections": [
            "format",
            "alignment",
            "direction",
            "indentation",
            "blocks",
            "list",
            "insert",
            "sr_script",
            "editor"
          ]
        },
        "actions": {
          "bold": {
            "tag": "strong",
            "shortcut": "Mod-B",
            "label": "Bold"
          },
          "italic": {
            "tag": "em",
            "shortcut": "Mod-I",
            "label": "Italic"
          },
          "bullet_list": {
            "wrapInParagraphs": true,
            "label": "Bullet List"
          },
          "ordered_list": {
            "wrapInParagraphs": false,
            "label": "Numbered List"
          },
          "link": {
            "hideTarget": false,
            "shortcut": "Mod-K",
            "label": "Add Link"
          },
          "unlink": {
            "label": "Remove Link"
          },
          "image": {
            "wrapInPicture": false,
            "shortcut": "Mod-Shift-I",
            "label": "Insert Image"
          },
          "table": {
            "wrapInParagraphs": false,
            "shortcut": "Mod-Alt-T",
            "label": "Insert Table"
          },
          "special_characters": {
            "label": "Special Characters"
          },
          "paste_text": {
            "shortcut": "Mod-Shift-v",
            "label": "Paste as Text"
          },
          "h1": {
            "shortcut": "Mod-Alt-1",
            "label": "Heading 1"
          },
          "h2": {
            "shortcut": "Mod-Alt-2",
            "label": "Heading 2"
          },
          "h3": {
            "shortcut": "Mod-Alt-3",
            "label": "Heading 3"
          },
          "h4": {
            "shortcut": "Mod-Alt-4",
            "label": "Heading 4"
          }
        }
      }
    }
  ]
}
